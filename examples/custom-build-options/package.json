{
  "private": true,
  "name": "my-nextron-app",
  "description": "My application description",
  "version": "1.0.0",
  "author": "Yoshihide Shiono <shiono.yoshihide@gmail.com>",
  "type": "module",
  "main": "app/main.js",
  "scripts": {
    "dev": "nextron",
    "build": "nextron build",
    "build:prod": "nextron build --config electron-builder.prod.yml",
    "build:mac": "nextron build --mac --x64",
    "build:mac:universal": "nextron build --mac --universal",
    "build:win": "nextron build --win --ia32",
    "build:linux": "nextron build --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-serve": "^3.0.0",
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/react": "^19.2.14",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "next": "^16.3.0",
    "nextron": "^10.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
